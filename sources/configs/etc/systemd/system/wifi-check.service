[Unit]
Description=Check Wi-Fi or enable hotspot
After=network-online.target
Wants=network-online.target

[Service]
# simple, not oneshot: the script ends running lighttpd in the foreground, so as a oneshot the
# unit never left "activating" and anything ordered after it would never start.
Type=simple
ExecStart=/usr/local/bin/check_wifi_or_hotspot.sh

[Install]
WantedBy=multi-user.target
