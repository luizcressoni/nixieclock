# ------------------------------------------------------------------ secrets
# The real config holds the home Wi-Fi, coordinates and weather API key.
# The tracked template is nixie.default.json; tools/make_image.sh starts from it.
# Run ./tools/check_secrets.sh before every commit.
www/json/nixie.json
/nixie.json
*.key
secrets.cmake
wpa_supplicant.conf
userconf.txt

# ------------------------------------------------------------------ binaries
# Build output. build.sh redoes it in minutes.
sources/clock/build/
sources/clock/rpibuild/
sources/clock/dockerbuild/
sources/clock/cmake-build-debug/
nixiepi/nixie
nixiepi/camera
nixiepi/liblogger.so
www/cgi-bin/nixie.cgi
*.o
*.so
*.a

# tools/make_image.sh output: the image and the download cache.
/build/
*.img
*.img.xz

# ------------------------------------------------------------ documentation
# Doxygen output from sources/clock/Doxyfile:
#   cd sources/clock && doxygen Doxyfile
sources/clock/docs/

# ------------------------------------------------------ third-party sources
# Not ours, all reproducible:
#   OpenCV   -> from apt (libopencv-* 4.5); this source tree builds nothing.
#   lighttpd -> tools/make_image.sh downloads the 1.4.78 tarball and checks
#               its sha256. The folder below is the extracted tree.
sources/opencv/
/lighttpd-1.4.78/
sources/lighttpd-1.4.78.tar.gz

# Duplicate: camera loads its cascades from nixiepi/.
sources/haarcascade_frontalface_default.xml

# Two deliberate exceptions, KEPT in git:
#   sources/clock/src/logger/spdlog/  -- header-only, built into liblogger.so.
#     Bullseye ships 1.8.1; the clock runs on 1.11.0.
#   nixiepi/*.xml  -- OpenCV cascades, but runtime data: without them the
#     clock boots showing error "99   1".

# ------------------------------------------------------------------- IDE
.idea/
.vscode/
*.swp
*~
